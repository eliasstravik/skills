{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "winner",
    "reasoning",
    "rubric",
    "output_quality"
  ],
  "properties": {
    "winner": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "TIE"
      ]
    },
    "reasoning": {
      "type": "string"
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "$ref": "#/$defs/sideRubric"
        },
        "B": {
          "$ref": "#/$defs/sideRubric"
        }
      }
    },
    "output_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "$ref": "#/$defs/sideQuality"
        },
        "B": {
          "$ref": "#/$defs/sideQuality"
        }
      }
    }
  },
  "$defs": {
    "sideRubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctness",
        "completeness",
        "accuracy",
        "organization",
        "usability",
        "overall_score"
      ],
      "properties": {
        "correctness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "completeness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "accuracy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "organization": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "usability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "overall_score": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "sideQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "strengths",
        "weaknesses"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 1,
          "maximum": 10
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weaknesses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
