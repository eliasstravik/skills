#!/usr/bin/env bash
# Logging stand-in for herdr-projects in autoproject evals.
# Every call and its standard input go to <run>/hp-calls.log. Answers come from
# <run>/canned/; nothing launches agents, panes, git, or GitHub.
set -u
RUN="$(cd "$(dirname "$0")/.." && pwd)"
LOG="$RUN/hp-calls.log"
CANNED="$RUN/canned"
[ "${1:-}" = "--root" ] && shift 2

stdin=""
for arg in "$@"; do
  if [ "$arg" = "-" ]; then stdin="$(cat)"; fi
done
{
  printf '=== hp'
  printf ' %q' "$@"
  printf '\n'
  if [ -n "$stdin" ]; then printf '%s\n--- end stdin\n' "$stdin"; fi
} >> "$LOG"

project_dir() { echo "$RUN/root/${1:-tally}"; }

case "${1:-} ${2:-}" in
  "skill "*)
    cat "$RUN/share/coordinator-skill.md" ;;
  "context "*)
    dir="$(project_dir "${2:-}")"
    python3 - "$CANNED/context.txt" "$dir" <<'PY'
import sys, pathlib
text = pathlib.Path(sys.argv[1]).read_text()
d = pathlib.Path(sys.argv[2])
def read(name, empty):
    p = d / name
    body = p.read_text().strip() if p.exists() else ""
    return body or empty
text = text.replace("@@TASKS@@", read("TASKS.md", "(none)")).replace("@@MEMORY@@", read("MEMORY.md", ""))
sys.stdout.write(text)
PY
    ;;
  "thread start")
    for arg in "$@"; do
      if [ "$arg" = "--help" ] || [ "$arg" = "-h" ]; then
        echo "Usage: hp thread start <SLUG> --title <TITLE> [--repo <PATH>] [--kind <KIND>] [--agent <KIND>] [--agent-arg <ARG>]... [--base <REF>] --task-file <PATH|->"
        exit 0
      fi
    done
    n_file="$RUN/.shim-start-count"
    n=$(( $(cat "$n_file" 2>/dev/null || echo 0) + 1 ))
    echo "$n" > "$n_file"
    response="$(sed -n "${n}p" "$CANNED/start-responses.txt" 2>/dev/null)"
    [ -z "$response" ] && response="$(tail -n 1 "$CANNED/start-responses.txt" 2>/dev/null)"
    case "$response" in
      err\ *)
        echo "error: ${response#err }" >&2
        exit 1 ;;
      *)
        id="${response#ok }"
        [ -z "$id" ] && id="t-00$((n + 7))"
        title="thread"
        prev=""
        for arg in "$@"; do
          if [ "$prev" = "--title" ]; then title="$arg"; fi
          prev="$arg"
        done
        slugged="$(echo "$title" | tr 'A-Z ' 'a-z-')"
        printf '{"agent":"claude","branch":"hp/tally/%s-%s","id":"%s","kind":"worktree","pane_id":"w3:p%s"}\n' "$id" "$slugged" "$id" "$n" ;;
    esac ;;
  "thread show")
    id="${4:-}"
    if [ -f "$CANNED/show-$id.txt" ]; then
      cat "$CANNED/show-$id.txt"
    else
      origin="$(cat "$CANNED/origin.txt" 2>/dev/null)"
      base="$(cat "$CANNED/base.txt" 2>/dev/null || echo origin/main)"
      cat <<EOF
group = "Working"
live = "working"
id = "$id"
status = "open"
kind = "worktree"
repo = "$RUN/repo"
origin = "$origin"
branch = "hp/tally/$id-thread"
base = "$base"
agent = "claude"
EOF
    fi ;;
  "thread list")
    cat "$CANNED/list.txt" 2>/dev/null ;;
  "thread prompt")
    echo "sent to ${4:-?} (agent was idle)" ;;
  "thread resolve")
    echo "${4:-?} resolved; its report and library are kept." ;;
  "thread ack")
    echo "${4:-?}: report acknowledged" ;;
  "thread next")
    echo "${4:-?} has no Next list" ;;
  "inbox done")
    echo "done" ;;
  "safety show")
    cat "$CANNED/safety.txt" 2>/dev/null || echo 'start_threads = "propose"' ;;
  *)
    echo "ok" ;;
esac
